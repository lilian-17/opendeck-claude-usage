{
	"Name": "Claude Usage",
	"Author": "verso",
	"Version": "0.3.0",
	"SDKVersion": 2,
	"Description": "Shows your Claude subscription usage and Claude Code status.",
	"Icon": "icons/icon",
	"Category": "Claude",
	"CategoryIcon": "icons/icon",
	"OS": [
		{
			"Platform": "linux",
			"MinimumVersion": "0"
		}
	],
	"Software": {
		"MinimumVersion": "6.0"
	},
	"CodePathLin": "bin/claude-usage",
	"Actions": [
		{
			"Name": "Claude Usage",
			"UUID": "com.verso.claudeusage.usage",
			"Icon": "icons/icon",
			"Tooltip": "Claude usage percentage. Press = refresh.",
			"Controllers": [
				"Keypad"
			],
			"SupportedInMultiActions": false,
			"DisableAutomaticStates": true,
			"PropertyInspectorPath": "propertyInspector/inspector.html",
			"States": [
				{
					"Image": "icons/icon",
					"ShowTitle": false
				}
			]
		},
		{
			"Name": "Claude Code Status",
			"UUID": "com.verso.claudeusage.status",
			"Icon": "icons/status",
			"Tooltip": "Color by Claude Code state: thinking, waiting for you, done. Press = acknowledge.",
			"Controllers": [
				"Keypad"
			],
			"SupportedInMultiActions": false,
			"DisableAutomaticStates": true,
			"PropertyInspectorPath": "propertyInspector/status.html",
			"States": [
				{
					"Image": "icons/status",
					"ShowTitle": false
				}
			]
		}
	]
}
