#!/usr/bin/env bash
# Launcher: OpenDeck runs this script with the Stream Deck SDK arguments.
# Look for a node binary (PATH, then mise/nvm installs) because OpenDeck
# started from the desktop doesn't necessarily inherit the shell's PATH.
DIR="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"

NODE="$(command -v node 2>/dev/null)"
if [ -z "$NODE" ]; then
	NODE="$(ls -d "$HOME"/.local/share/mise/installs/node/*/bin/node "$HOME"/.nvm/versions/node/*/bin/node 2>/dev/null | sort -V | tail -1)"
fi
if [ -z "$NODE" ]; then
	echo "claude-usage: node not found" >&2
	exit 1
fi

exec "$NODE" "$DIR/plugin.js" "$@"
